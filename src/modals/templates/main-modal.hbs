<div
  class="modal-dialog modal-lg"
  role="document"
  style="width: 95%; margin: 40px auto"
>
  <div class="modal-content" action="">
    <div class="modal-header">
      <h1 class="modal-title" id="lssp-modal-label">LSS-Planner</h1>
      <button
        type="button"
        class="close"
        data-dismiss="modal"
        aria-label="Close"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div
      id="lssp-modal-body"
      class="modal-body"
      style="height: calc(100vh - 350px); overflow-y: auto"
    >
      <div>
        <ul class="nav nav-tabs" role="tablist" style="margin-bottom: 10px">
          <li role="presentation" class="active">
            <a
              href="#lssp-modal-dash-panel"
              aria-controls="lssp-modal-dash-panel"
              role="tab"
              data-toggle="tab"
              >Übersicht</a
            >
          </li>
          <li role="presentation">
            <a
              href="#lssp-modal-backup-panel"
              aria-controls="lssp-modal-backup-panel"
              role="tab"
              data-toggle="tab"
              >BackUp</a
            >
          </li>
          <li role="presentation">
            <a
              href="#lssp-modal-settings-panel"
              aria-controls="lssp-modal-settings-panel"
              role="tab"
              data-toggle="tab"
              >Einstellungen</a
            >
          </li>
        </ul>
        <div class="tab-content">
          <div
            role="tabpanel"
            class="tab-pane active"
            id="lssp-modal-dash-panel"
          >
            <div class="form-inline" style="margin-bottom: 10px">
              <div class="form-group" style="margin-right: 10px">
                <label class="sr-only" for="lssp-modal-dash-search">Suche</label>
                <input
                  id="lssp-modal-dash-search"
                  class="form-control"
                  type="search"
                  placeholder="Suche"
                />
              </div>
              <div class="form-group" style="margin-right: 10px">
                <label for="lssp-modal-dash-sort" style="margin-right: 5px">Sortierung</label>
                <select id="lssp-modal-dash-sort" class="form-control">
                  <option value="category-name">Kategorie, Name</option>
                  <option value="category-type">Kategorie, Typ</option>
                  <option value="name">Name</option>
                  <option value="type">Typ</option>
                </select>
              </div>
              <button
                type="button"
                class="btn btn-default"
                id="lssp-modal-dash-clear-search"
              >
                Zurücksetzen
              </button>
            </div>
            <table
              id="lssp-modal-dash-table"
              class="table table-striped tablesorter tablesorter-default"
              role="grid"
            >
              <thead>
                <tr class="tablesorter-headerRow" role="row">
                  <th></th>
                  <th>Name</th>
                  <th>Typ</th>
                  <th>Kategorie</th>
                </tr>
              </thead>
              <tbody
                id="lssp-modal-dash-table-body"
                aria-live="polite"
                aria-relevant="all"
              ></tbody>
            </table>
          </div>
          <div role="tabpanel" class="tab-pane" id="lssp-modal-backup-panel">
            <div>
              <h2>JSON-Datei</h2>
              <input
                type="file"
                id="lssp-modal-selectFiles"
                value="Import"
              /><br /><button id="lssp-modal-import" class="btn btn-default">
                Importieren</button
              ><button id="lssp-modal-export" class="btn btn-success">
                Herunterladen
              </button>
            </div>
            <div>
              <h2>Notizen</h2>
              <button id="lssp-modal-export-notes" class="btn btn-success">
                in Notizen Exportieren</button
              ><button id="lssp-modal-import-notes" class="btn btn-success">
                aus Notizen Importieren
              </button>
            </div>
            <div>
              <h2>Zu Importierende Daten</h2>
              <table
                class="table table-striped tablesorter tablesorter-default"
              >
                <thead>
                  <tr class="tablesorter-headerRow" role="row">
                    <th></th>
                    <th>Name</th>
                    <th>Typ</th>
                    <th>Kategorie</th>
                  </tr>
                </thead>
                <tbody id="lssp-modal-body-output"></tbody>
              </table>
              <button
                id="lssp-modal-import-save"
                class="btn btn-success row"
                type="button"
              >
                Speichern</button
              ><button id="lssp-modal-delete" class="btn btn-danger">
                Alles Löschen
              </button>
            </div>
          </div>
          <div
            role="tabpanel"
            class="tab-pane"
            id="lssp-modal-settings-panel"
          >
            <h2>Pläne verstecken</h2>
            <button
              type="button"
              class="btn btn-default"
              id="lssp-modal-settings-hide-all"
            >
              Alle verstecken
            </button>
            <div id="lssp-modal-settings-categories" style="margin-top: 15px"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
